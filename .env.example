# The app needs no API keys. One optional setting:
#
# Your contact email, sent to OpenStreetMap's Nominatim geocoder as identification (its usage policy asks for this).
NUXT_CONTACT_EMAIL=

# Optional: an ArcGIS location-services API key for the address search (Esri's World Geocoder). Without it the
# anonymous service is used, which works but is meant for light, non-commercial use.
NUXT_ARCGIS_KEY=

# Optional: the species library in a database, editable at /admin. Without these the bundled library is used.
# MongoDB Atlas (free tier is plenty): create a cluster, a database user, allow access from anywhere (0.0.0.0/0) for
# Vercel, and paste the connection string here.
NUXT_MONGODB_URI=
NUXT_MONGODB_DB=designafoodforest
# The password for /admin. Use a long one.
NUXT_ADMIN_PASSWORD=
# Optional: 32+ random characters to sign the admin session cookie (e.g. from `openssl rand -hex 32`).
NUXT_SESSION_SECRET=
